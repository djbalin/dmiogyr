# MET Norway requires an identifying contact in the User-Agent of every
# request. Set this to your own email or repository URL before deploying.
# https://developer.yr.no/doc/TermsOfService/
WEATHER_CONTACT=you@example.com

# Serve generated fixtures instead of calling DMI and MET Norway. Useful for
# offline development and CI. Anything other than "1" is off.
# WEATHER_MOCK=1
